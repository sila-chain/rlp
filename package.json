{
  "name": "@sila-chain/rlp",
  "version": "10.1.2",
  "description": "Recursive Length Prefix Encoding Module",
  "keywords": [
    "rlp",
    "sila"
  ],
  "homepage": "https://github.com/sila-chain/rlp#readme",
  "bugs": {
    "url": "https://github.com/sila-chain/rlp/issues?q=is%3Aissue+label%3A%22package%3A+rlp%22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sila-chain/rlp.git"
  },
  "license": "MPL-2.0",
  "author": {
    "name": "martin becze",
    "email": "mjbecze@gmail.com"
  },
  "contributors": [
    "Alex Beregszaszi <alex@rtfs.hu>",
    "Holger Drewes <Holger.Drewes@gmail.com>",
    "Paul Miller <pkg@paulmillr.com>"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "typescript": "./src/index.ts",
        "default": "./dist/esm/index.js"
      },
      "require": "./dist/cjs/index.js"
    }
  },
  "bin": {
    "rlp": "bin/rlp.cjs"
  },
  "files": [
    "dist",
    "bin",
    "src"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:post",
    "build:esm": "tsc --build ./tsconfig.prod.esm.json",
    "build:cjs": "tsc --build ./tsconfig.prod.cjs.json",
    "build:post": "node -e \"const fs=require('node:fs');for(const [dir,type] of [['dist/cjs','commonjs'],['dist/esm','module']]){fs.mkdirSync(dir,{recursive:true});fs.writeFileSync(dir+'/package.json',JSON.stringify({type},null,2)+'\\\\n')}\"",
    "build:benchmarks": "tsc --build ./tsconfig.benchmarks.json",
    "clean": "node -e \"const fs=require('node:fs');for(const p of ['dist','coverage'])fs.rmSync(p,{recursive:true,force:true});for(const p of fs.readdirSync('.'))if(p.endsWith('.tsbuildinfo'))fs.rmSync(p,{force:true})\"",
    "coverage": "vitest run --environment=node --coverage.enabled=true --coverage.provider=v8",
    "coverage:istanbul": "vitest run --environment=node --coverage.enabled=true --coverage.provider=istanbul",
    "examples": "tsx ./examples/simple.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:spelling": "cspell --no-progress \"**/*.{ts,mts,cjs,mjs,md}\"",
    "prepublishOnly": "npm run clean && npm run build && npm run test",
    "test": "npm run test:node",
    "test:node": "vitest run --environment=node",
    "test:browser": "vitest run --config=./vitest.config.browser.mts",
    "tsc": "tsc -p ./tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/benchmark": "2.1.5",
    "@types/node": "22.13.10",
    "@vitest/browser": "4.1.7",
    "@vitest/browser-playwright": "4.1.7",
    "@vitest/coverage-istanbul": "4.1.7",
    "@vitest/coverage-v8": "4.1.7",
    "benchmark": "2.1.4",
    "cspell": "8.19.4",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "playwright": "1.60.0",
    "tsx": "4.22.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.0",
    "vitest": "4.1.7"
  }
}
